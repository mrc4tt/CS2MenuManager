<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PublishDir>./bin/CS2MenuManager_MenuManager/</PublishDir>
  </PropertyGroup>
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutputPath>$(ProjectDir)..\BuildOutput\plugins\CS2MenuManager_MenuManager\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>
	
	<ItemGroup>
		<PackageReference Include="CounterStrikeSharp.API" Version="1.0.369">
				<ExcludeAssets>runtime</ExcludeAssets>
			</PackageReference>
		<ProjectReference Include="..\CS2MenuManager\CS2MenuManager.csproj" />
		<None Update="lang\**\*.*" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<Target Name="PostBuild" AfterTargets="Build">
		<ItemGroup>
			<FilesToDelete Include="$(OutputPath)CS2MenuManager.dll" />
			<FilesToDelete Include="$(OutputPath)CS2MenuManager.pdb" />
			<FilesToDelete Include="$(OutputPath)CS2MenuManager.xml" />
		</ItemGroup>
		<Delete Files="@(FilesToDelete)" />
	</Target>
</Project>
